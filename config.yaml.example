# 复制为 config.yaml 后填写真实值。config.yaml 已被 .gitignore 忽略，不会误提交。
#
# 优先级：环境变量 DEEPSEEK_API_KEY / API_AUTH_KEY 会覆盖这里的同名配置。
# 只支持扁平的 "key: value"，不支持嵌套、列表和多行值（解析到这些会直接报错）。

deepseek_api_key: "sk-你的key"
api_auth_key: "你的服务端密钥"

# 可选：LLM 模型名称，默认空由服务装配层缺省为 deepseek-chat。环境变量 MODEL 优先级更高。
model: "deepseek-chat"

# 可选：SQLite 持久化文件路径。留空则用内存存储（重启丢任务）。
# 例如：db_path: "agent-api.db"
db_path: ""

# 可选：向量通道独立凭证（检索混合召回用）。全部留空 = 仅词法检索（lexical only，ADR-0017 决策 3）。
# 启用混合召回时需配置 embed_base_url、embed_model、embed_dim（正整数，0 表示不建向量表）。
# 本地 Ollama 等免密服务无需鉴权时，embed_api_key 可以留空。
# 环境变量 EMBED_BASE_URL / EMBED_API_KEY / EMBED_MODEL / EMBED_DIM 优先级更高。
embed_base_url: ""
embed_api_key: ""
embed_model: ""
embed_dim: 0

# 可选：最大允许积压的任务数，超出回 503。默认 10000。环境变量 MAX_QUEUE_SIZE 优先级更高。
max_queue_size: 10000

worker_concurrency: 3   # 可选：后台并发 Worker 数量（正整数，默认 3）。环境变量 WORKER_CONCURRENCY 优先级更高。
max_context_tokens: 16000 # 可选：会话多轮对话上下文 Token 预算上限（正整数，默认 16000）。环境变量 MAX_CONTEXT_TOKENS 优先级更高。
session_history_limit: 100 # 可选：组装会话历史时拉取的最大消息条数（正整数，默认 100）。环境变量 SESSION_HISTORY_LIMIT 优先级更高。
pprof_addr: ""          # 可选：非空则在独立端口暴露 /debug/pprof（如 127.0.0.1:6060）；空 = 关闭。环境变量 PPROF_ADDR 优先级更高。
